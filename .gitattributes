# Normalizar archivos de texto a LF
* text=auto eol=lf

# Código y configuración
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.php  text eol=lf
*.json text eol=lf
*.txt  text eol=lf
*.md   text eol=lf
*.svg  text eol=lf

# Archivos binarios
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.pdf  binary
*.zip  binary